import tkinter as tk
from tkinter import messagebox

# Function to show info on screen
def show_info():
    name = name_entry.get()
    roll = roll_entry.get()
    course = course_entry.get()

    result_label.config(text=f"Name: {name}\nRoll No: {roll}\nCourse: {course}")

# Function to save info in a file
def save_info():
    name = name_entry.get()
    roll = roll_entry.get()
    course = course_entry.get()

    if name == "" or roll == "" or course == "":
        messagebox.showwarning("Missing Details", "Please fill all fields before saving.")
        return

    with open("student_info.txt", "a") as file:
        file.write(f"Name: {name}, Roll: {roll}, Course: {course}\n")

    messagebox.showinfo("Saved", "Student information saved successfully!")

# Function to clear all fields
def clear_fields():
    name_entry.delete(0, tk.END)
    roll_entry.delete(0, tk.END)
    course_entry.delete(0, tk.END)
    result_label.config(text="")

root = tk.Tk()
root.title("Student Info GUI")
root.geometry("350x350")

# Labels + Entry Fields
name_label = tk.Label(root, text="Student Name:")
name_label.pack(pady=5)
name_entry = tk.Entry(root)
name_entry.pack(pady=5)

roll_label = tk.Label(root, text="Roll Number:")
roll_label.pack(pady=5)
roll_entry = tk.Entry(root)
roll_entry.pack(pady=5)

course_label = tk.Label(root, text="Course:")
course_label.pack(pady=5)
course_entry = tk.Entry(root)
course_entry.pack(pady=5)

# Buttons
show_btn = tk.Button(root, text="Show Info", command=show_info)
show_btn.pack(pady=5)

save_btn = tk.Button(root, text="Save Info", command=save_info)
save_btn.pack(pady=5)

clear_btn = tk.Button(root, text="Clear", command=clear_fields)
clear_btn.pack(pady=5)

# Output Label
result_label = tk.Label(root, text="", font=("Arial", 12))
result_label.pack(pady=10)

root.mainloop()
